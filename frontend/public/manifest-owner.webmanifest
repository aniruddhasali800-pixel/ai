{
  "id": "/owner.html",
  "name": "Sizzle Owner — Restaurant OS",
  "short_name": "Sizzle Owner",
  "description": "Run the whole restaurant from one icon: live orders, the floor, the menu, stock, staff, reports, the audit trail and settings. Sign in with your owner account.",
  "lang": "en-IN",
  "dir": "ltr",
  "start_url": "/owner.html",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "any",
  "background_color": "#1c1917",
  "theme_color": "#1c1917",
  "categories": ["business", "productivity", "food"],
  "icons": [
    {
      "src": "/icons/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Today",
      "short_name": "Today",
      "description": "Sales, covers and the live order rail",
      "url": "/app",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Orders",
      "short_name": "Orders",
      "description": "Every ticket the kitchen has fired",
      "url": "/app/orders",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Tables & QR",
      "short_name": "Tables",
      "description": "The floor map and every printed code",
      "url": "/app/tables",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Reports",
      "short_name": "Reports",
      "description": "Sales, covers and menu engineering",
      "url": "/app/reports",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
