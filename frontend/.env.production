# Compiled into `npm run build`. This is the Render API this demo talks to; a
# host-level VITE_API_URL overrides it, and development needs nothing because Vite
# proxies /api to a local backend. Never put secrets here — Vite inlines it into the
# bundle the browser downloads.
VITE_API_URL=https://ai-1-hsus.onrender.com
