# Copy to .env and adjust. Never commit real secrets.
NODE_ENV=development
PORT=4000

# Not read by the API: every record is a file under ARCHIVE_DIR, in this service's own filesystem.
# It stays listed here (and in render.yaml) only so an older deployment's value survives a sync.
MONGODB_URI=

# Where the record folders live. Relative paths are taken from backend/.
# ARCHIVE_DIR=.data/archive

ACCESS_TOKEN_SECRET=change-me-dev-access-secret-000000
REFRESH_TOKEN_SECRET=change-me-dev-refresh-secret-000000
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Comma-separated list — both HTTP CORS and the Socket.IO handshake accept every entry.
# Add the LAN address here (e.g. http://192.168.1.42:5173) to let phones on the same
# Wi-Fi connect, and set PUBLIC_BASE_URL to that same address so printed table QR codes,
# guest bill links and payment links point at a host the phone can actually resolve.
CORS_ORIGIN=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:5173
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret

# Optional payment gateway (mock provider is used when unset)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# The bill service (the `bill/` app) — the payee UPI ID, the guest's pay page, the
# verification queue and the income figures live there, not here.
# Leave both blank to keep this build on its own UPI handle and the sandbox gateway.
# When set, every finalised bill raises a UPI request by itself and the counter shows
# that QR. BILL_SERVICE_SHARED_SECRET must equal SIZZLE_SHARED_SECRET in ../bill/.env
# (run `npm run setup:env` in bill/ to print the matching pair). `npm run dev` in both
# folders is enough — nothing else to install.
BILL_SERVICE_BASE_URL=http://localhost:3100
BILL_SERVICE_SHARED_SECRET=
# The key header names this caller; must equal PAY_SERVICE_KEY in ../bill/.env.
BILL_SERVICE_KEY=sizzle-pay

# Delivery partner webhook secrets
SWIGGY_WEBHOOK_SECRET=dev-swiggy-secret
ZOMATO_WEBHOOK_SECRET=dev-zomato-secret

# Deployment. With NODE_ENV=production the API refuses to boot unless ACCESS_TOKEN_SECRET and
# REFRESH_TOKEN_SECRET hold values that are neither the development defaults nor this template's
# change-me strings (generate real ones with `openssl rand -hex 32`).
#
# When ../frontend/dist exists, this process also serves the built React app, so a
# single service on a single port carries the site, /api, /uploads and /socket.io.
# Set STATIC_DIR only if the client lives somewhere unusual.
# STATIC_DIR=../frontend/dist
#
# CORS_ORIGIN and PUBLIC_BASE_URL already default to RENDER_EXTERNAL_URL when a host
# publishes its own address that way, so QR codes and the socket allowlist follow the
# domain you deployed on. Override them for any other host.
#
# Booting against an empty database loads the demo tenant; set false for a clean install.
# AUTO_SEED=false
#
# Demo logins. A fresh checkout sets neither, and that is the point: the seed still builds the
# restaurant, its menu, its tables and fourteen days of history, but it writes no password onto any
# of those staff rows, so nothing that ships with this repository opens anything. Set
# DEMO_STAFF_PASSWORD to give every seeded staff account one password for a local walk-through (the
# accounts sign in by phone number, since the seed gives them no email). DEMO_MASTER_PASSWORD is the
# separate door that opens any active account of the demo tenant without its own password.
# DEMO_STAFF_PASSWORD=
# DEMO_MASTER_PASSWORD=

